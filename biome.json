{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "enabled": false,
    "rules": {
      "recommended": true
    }
